# SIMO - Variables del despliegue. Copiar a deploy/.env y completar.
# deploy/.env NUNCA se sube a GitHub (está en .gitignore).
#
# Para generar contraseñas seguras en la Mac:
#   openssl rand -base64 24

# --- PostgreSQL (superusuario: solo para administración y respaldos) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=simo_retail

# --- Rol de la API (mínimo privilegio) ---
SIMO_APP_PASSWORD=

# Datos de prueba del seed (usuarios con contraseña conocida). En el
# despliegue compartido debe quedar en false; crear el administrador con
# tools/crear-admin.js (ver deploy/README.md).
SIMO_SEED=false

# --- Cloudflare Tunnel ---
# Zero Trust > Networks > Tunnels > (túnel simo) > Docker: el valor después de --token
CLOUDFLARE_TUNNEL_TOKEN=

# --- Respaldos ---
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
