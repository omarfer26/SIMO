# SIMO - Variables de producción para docker-compose.prod.yml (SCRUM-173)
# Copiar a .env.prod y completar. .env.prod NUNCA se sube al repositorio.
# En Render estas mismas variables se definen en el panel del servicio.

# Neon, rol simo_app, host con "-pooler":
#   postgresql://simo_app:<clave>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clave de las sesiones: 32 caracteres o más, aleatoria. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcionales
JWT_EXPIRES_IN=30m
TRUST_PROXY=1
RATE_LIMIT_MAX=100
API_PORT=3000
APP_VERSION=

# Solo para el perfil "migraciones" (cadena DIRECTA del dueño de Neon, sin -pooler)
NEON_MIGRACIONES_URL=
SIMO_APP_PASSWORD=
