# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
# Carpeta de build de Next.js: a veces queda mal ubicada acá en la raíz
# por el package.json suelto en la raíz que confunde a Turbopack sobre 
# cuál es el "workspace root".
.next/
out/

# production
build/

# misc
.DS_Store
*.pem
camilo-sanchez.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
